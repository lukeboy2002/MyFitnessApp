# /etc/systemd/system/myfitnessapp-queue.service
# Verwerkt de queue (QUEUE_CONNECTION=database), bv. mails.
# sudo systemctl daemon-reload && sudo systemctl enable --now myfitnessapp-queue

[Unit]
Description=MyFitnessApp queue worker
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=5
WorkingDirectory=/var/www/myfitnessapp
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600

[Install]
WantedBy=multi-user.target
